EXCOMPASS_ENV=development
EXCOMPASS_APP_NAME=ExCompass
EXCOMPASS_CITY=Pune
EXCOMPASS_BASE_PATH=

# Active runtime: database-free JSON repository
STORAGE_DRIVER=json
EXCOMPASS_STORAGE_PATH=

EXCOMPASS_SESSION_NAME=excompass_admin
EXCOMPASS_SESSION_IDLE=7200

# Future database adapter compatibility only; normal runtime does not use these.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=excompass
DB_USERNAME=excompass
DB_PASSWORD=
